# Copy to .env.local (git-ignored). Only PUBLIC values here — never ANTHROPIC_API_KEY (CLAUDE.md §2.5).
# From `npx supabase start` (local) or your Supabase project settings → API.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Base URL put inside the emergency QR code (your deployed web app, or your computer's LAN IP for phone tests)
EXPO_PUBLIC_APP_URL=http://localhost:8081
# Password of the seeded demo accounts (see supabase/seed.sql)
EXPO_PUBLIC_DEMO_PASSWORD=DjiHealth-demo-2026
